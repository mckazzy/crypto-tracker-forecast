# Crypto Tracker Forecast — environment config
BINANCE_REST_BASE=https://api.binance.com
BINANCE_WS_BASE=wss://stream.binance.com:9443
DATA_DIR=./data

# Server: loopback only, never 0.0.0.0
HOST=127.0.0.1
PORT=8000

# CORS allowlist (comma-separated, no "*")
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Ingest defaults
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT
TIMEFRAMES=5m,15m,1h,4h,1d,1w

# AI provider (SP2) — OpenRouter (OpenAI-compatible), key từ https://openrouter.ai/keys
AI_ENABLED=false
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=
AI_MODEL=deepseek/deepseek-v4-flash-0731
AI_DAILY_TOKEN_BUDGET=200000
# AI_MODEL_CHOICES — curated whitelist hiển thị trên front-end (comma-separated)

# Alerts (SP4) — Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
FEEDBACK_MIN_SIGNALS=10

# Futures demo exchange (SP5) — JWT auth (bắt buộc, >= 32 chars, ví dụ: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET=
